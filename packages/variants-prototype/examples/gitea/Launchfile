# Experimental input for this package only. Existing Launchfile tools do not support variants.
# Proposed author edit: the shipped catalog entry requires PostgreSQL; this SQLite baseline is new.
name: gitea
image: gitea/gitea:latest
provides:
  - name: web
    protocol: http
    port: 3000
    exposed: true
env:
  GITEA__database__DB_TYPE: sqlite3
  GITEA__database__PATH: /data/gitea/gitea.db
  GITEA__server__ROOT_URL: $app.url
  GITEA__server__DISABLE_SSH: true
storage:
  data:
    path: /data
    persistent: true
health: /api/healthz
variants:
  postgres:
    requires:
      - type: postgres
        set_env:
          GITEA__database__DB_TYPE: postgres
          GITEA__database__HOST: ${host}:${port}
          GITEA__database__NAME: $name
          GITEA__database__USER: $user
          GITEA__database__PASSWD: $password
    env:
      GITEA__server__ROOT_URL: $app.url
      GITEA__server__DISABLE_SSH: true

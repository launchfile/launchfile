{
  "name": "@launchfile/public-https-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "bun run --cwd ../../sdk build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run build:sdk && bun run typecheck && bun run test",
    "plan": "bun run src/cli.ts",
    "prove": "bun run scripts/prove.ts"
  },
  "dependencies": {
    "@launchfile/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}

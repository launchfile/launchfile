{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // The typecheck program also holds src/__tests__, and the macos-dev
    // declaration check reads that provider's source. Emit layout is not
    // decided here — tsconfig.build.json pins rootDir to src/.
    "rootDir": "../..",
    "outDir": "dist",
    "types": ["@types/bun", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}

# yaml-language-server: $schema=https://launchfile.dev/schema/v1
version: launch/v1
name: grocy
description: "Web-based groceries and household management for your home"
repository: https://github.com/grocy/grocy
logo: https://raw.githubusercontent.com/grocy/grocy/master/public/img/grocy_logo.svg

image: linuxserver/grocy:latest
provides:
  - name: web
    protocol: http
    port: 80
    exposed: true
supports:
  # Camera barcode scanning needs a secure connection; the rest of the app
  # works over plain HTTP, so this is the optional mood (README.md:98).
  - type: https-origin
    endpoint: web
storage:
  config:
    path: /config
    persistent: true
restart: always

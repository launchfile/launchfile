# yaml-language-server: $schema=https://launchfile.dev/schema/v1
version: launch/v1
name: syncthing
description: "Continuous peer-to-peer file synchronization"
repository: https://github.com/syncthing/syncthing

# The sync protocol listens on 22000 over both TCP and QUIC (UDP), and local
# discovery uses 21027/UDP (docs: users/firewall.rst). QUIC is not its own
# protocol value, so the 22000/UDP entry declares the transport, not the QUIC
# layer on top of it. Discovery stays internal: it relies on broadcast/multicast,
# which Docker's default bridge network does not forward (upstream
# README-Docker.md "Discovery") — see G-9 in ../../GAPS.md.

image: syncthing/syncthing:latest
provides:
  - name: web-ui
    protocol: http
    port: 8384
    exposed: true
  - name: sync
    protocol: tcp
    port: 22000
    exposed: true
  - name: sync-quic
    protocol: udp
    port: 22000
    exposed: true
  - name: discovery
    protocol: udp
    port: 21027
storage:
  data:
    path: /var/syncthing
    persistent: true
health: /rest/noauth/health
restart: always

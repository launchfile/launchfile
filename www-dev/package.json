{
  "name": "launchfile-www-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "schema:copy": "mkdir -p public/schema && cp ../spec/schema/launchfile.schema.json public/schema/v1",
    "predev": "bun run schema:copy",
    "prebuild": "bun run schema:copy",
    "predev:search": "bun run schema:copy",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist/client",
    "dev:search": "astro build && pagefind --site dist/client && cp -r dist/client/pagefind public/pagefind && astro dev",
    "preview": "astro preview",
    "typecheck": "astro check",
    "publish": "bun run build && bunx wrangler pages deploy dist/client --project-name launchfile-dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/markdown-satteri": "^0.4.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.4",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}

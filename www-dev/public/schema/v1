{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchfile.dev/schema/v1",
  "title": "Launchfile",
  "description": "Universal app descriptor — describes what an app needs to run, not how to deploy it.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Spec version (e.g., 'launch/v1')",
      "examples": ["launch/v1"]
    },
    "generator": {
      "type": "string",
      "description": "Tool that generated this file (e.g., 'my-tool/0.1.0')"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "App name (lowercase kebab-case, used as subdomain)"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the app"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "Canonical source origin URL (e.g. GitHub repository). On a git-hosted URL, a '#' fragment names the baseline ref (branch, tag, or commit SHA)"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "description": "Project homepage URL"
    },
    "logo": {
      "type": "string",
      "format": "uri",
      "description": "Logo image URL"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Discovery tags for catalog listings"
    },
    "secrets": {
      "type": "object",
      "description": "App-wide generated secrets, shared across components via $secrets.name",
      "additionalProperties": { "$ref": "#/$defs/secret" }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "image": {
      "type": "string",
      "description": "Pre-built OCI image (alternative to build)"
    },
    "build": { "$ref": "#/$defs/buildOrString" },
    "source": {
      "type": "string",
      "description": "Working directory for source-mode commands (install/dev). Defaults to build.context, then the repo root (D-38)."
    },
    "provides": {
      "type": "array",
      "items": { "$ref": "#/$defs/provides" }
    },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirementOrString" }
    },
    "supports": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirementOrString" }
    },
    "env": {
      "type": "object",
      "description": "App-owned environment variables",
      "additionalProperties": { "$ref": "#/$defs/envVarOrScalar" }
    },
    "commands": { "$ref": "#/$defs/commands" },
    "health": { "$ref": "#/$defs/healthOrString" },
    "depends_on": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependsOnOrString" }
    },
    "storage": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/storageVolume" }
    },
    "restart": { "$ref": "#/$defs/restartPolicy" },
    "schedule": {
      "type": "string",
      "description": "Cron schedule for scheduled jobs (e.g., '0 0 * * *')"
    },
    "singleton": {
      "type": "boolean",
      "description": "Cannot be horizontally scaled"
    },
    "platform": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ],
      "description": "OCI platform constraint (e.g., 'linux/amd64') or array of platforms"
    },
    "host": { "$ref": "#/$defs/host" },
    "components": {
      "type": "object",
      "description": "Named components for multi-service apps",
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "string",
      "enum": ["node", "bun", "deno", "python", "ruby", "go", "rust", "java", "php", "elixir", "csharp", "static"],
      "description": "Application runtime"
    },
    "protocol": {
      "type": "string",
      "enum": ["http", "https", "tcp", "udp", "grpc", "ws"],
      "description": "Network protocol"
    },
    "generator": {
      "type": "string",
      "enum": ["secret", "uuid", "port"],
      "description": "Auto-generation strategy"
    },
    "restartPolicy": {
      "type": "string",
      "enum": ["always", "on-failure", "no"],
      "description": "Restart policy"
    },
    "secret": {
      "type": "object",
      "required": ["generator"],
      "properties": {
        "generator": { "$ref": "#/$defs/generator" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provides": {
      "type": "object",
      "required": ["protocol", "port"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Endpoint name for cross-component referencing"
        },
        "protocol": { "$ref": "#/$defs/protocol" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "bind": {
          "type": "string",
          "description": "Bind address (default: '0.0.0.0')",
          "default": "0.0.0.0"
        },
        "exposed": {
          "type": "boolean",
          "description": "Reachable from outside the host",
          "default": false
        },
        "spec": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Resource name for referencing (defaults to type)"
        },
        "type": {
          "type": "string",
          "description": "Resource type (e.g., 'postgres', 'redis')"
        },
        "version": {
          "type": "string",
          "description": "Version constraint (e.g., '>=15')"
        },
        "config": {
          "type": "object",
          "description": "Resource-specific configuration"
        },
        "set_env": {
          "type": "object",
          "description": "Maps resource properties to app env vars. Use $prop for references, plain strings for literals.",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "requirementOrString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/requirement" },
        { "$ref": "#/$defs/hostCapability" }
      ]
    },
    "hostCapability": {
      "type": "object",
      "required": ["host"],
      "description": "Host capability entry (D-44): a privileged grant the provider grants or refuses, marked by the required 'host' field. Distinct from a backing service ('type' entry).",
      "properties": {
        "host": {
          "type": "object",
          "description": "Capability name → interface value (e.g. container_runtime: docker — the Docker Engine API, never a product name). Open vocabulary: unknown capabilities are tolerated.",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "boolean" }
            ]
          }
        },
        "set_env": {
          "type": "object",
          "description": "Maps granted capability properties (e.g. $socket, $url, $api for container_runtime) to app env vars. Use $prop for references, plain strings for literals.",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "envVar": {
      "type": "object",
      "properties": {
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ],
          "description": "Default value"
        },
        "description": {
          "type": "string",
          "description": "Human description (supports markdown)"
        },
        "label": {
          "type": "string",
          "description": "Short label for CLI prompts"
        },
        "required": {
          "type": "boolean",
          "description": "App cannot start without this value"
        },
        "example": {
          "type": "string",
          "description": "Example value showing expected format"
        },
        "generator": { "$ref": "#/$defs/generator" },
        "sensitive": {
          "type": "boolean",
          "description": "Store in secrets manager"
        }
      },
      "additionalProperties": false
    },
    "envVarOrScalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "$ref": "#/$defs/envVar" }
      ]
    },
    "build": {
      "type": "object",
      "properties": {
        "context": { "type": "string", "description": "Build context directory" },
        "dockerfile": { "type": "string", "description": "Path to Dockerfile" },
        "target": { "type": "string", "description": "Multi-stage build target" },
        "args": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "secrets": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Secrets available during build (never in image)"
        }
      },
      "additionalProperties": false
    },
    "buildOrString": {
      "oneOf": [
        { "type": "string", "description": "Build context path (shorthand)" },
        { "$ref": "#/$defs/build" }
      ]
    },
    "health": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "HTTP path to check" },
        "command": { "type": "string", "description": "Command for non-HTTP checks. If both path and command are present, path takes precedence." },
        "interval": { "type": "string", "description": "Check interval (e.g., '30s')" },
        "timeout": { "type": "string", "description": "Timeout per check" },
        "retries": { "type": "integer", "minimum": 1, "description": "Failures before unhealthy" },
        "start_period": { "type": "string", "description": "Grace period before failures count" }
      },
      "additionalProperties": false
    },
    "healthOrString": {
      "oneOf": [
        { "type": "string", "description": "Health check path (shorthand)" },
        { "$ref": "#/$defs/health" }
      ]
    },
    "commandDetail": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string" },
        "timeout": { "type": "string" },
        "capture": {
          "type": "object",
          "description": "Named captures extracted from this command's stdout via regex (D-34). Supersedes the top-level outputs: placement from D-23.",
          "additionalProperties": { "$ref": "#/$defs/output" }
        }
      },
      "additionalProperties": false
    },
    "commandOrString": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/commandDetail" }
      ]
    },
    "commands": {
      "type": "object",
      "properties": {
        "build": { "$ref": "#/$defs/commandOrString" },
        "install": {
          "$ref": "#/$defs/commandOrString",
          "description": "Source-mode prepare — install deps / codegen when running from source (D-38). The source-mode pair of build; a source launch runs `install ?? build` on demand. Ignored by providers that execute the built artifact."
        },
        "release": { "$ref": "#/$defs/commandOrString" },
        "start": { "$ref": "#/$defs/commandOrString" },
        "dev": {
          "$ref": "#/$defs/commandOrString",
          "description": "Source-mode run — run the app from source (D-38). The source-mode pair of start; run precedence is dev > image > start. Ignored by providers that execute the built artifact. Only prepare (install) and run (dev) are mode-aware; release/bootstrap/seed/test are mode-invariant."
        },
        "seed": { "$ref": "#/$defs/commandOrString" },
        "test": { "$ref": "#/$defs/commandOrString" }
      },
      "additionalProperties": { "$ref": "#/$defs/commandOrString" }
    },
    "output": {
      "type": "object",
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "description": "Regex with one capture group, matched against release command stdout" },
        "description": { "type": "string", "description": "Human-readable description of this output" },
        "sensitive": { "type": "boolean", "default": false, "description": "If true, value is masked in API/UI unless explicitly revealed" }
      },
      "additionalProperties": false
    },
    "storageVolume": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "Mount path inside the container" },
        "size": { "type": "string", "description": "Minimum size hint (e.g. '512MB', '10GB')" },
        "persistent": { "type": "boolean", "description": "Data survives restarts", "default": true },
        "content": { "enum": ["operator"], "description": "Who supplies the volume's content. 'operator': the operator supplies it — the provider binds it at path or refuses the component, and never initializes it empty (D-50)" }
      },
      "additionalProperties": false
    },
    "dependsOnEntry": {
      "type": "object",
      "required": ["component"],
      "properties": {
        "component": { "type": "string" },
        "condition": {
          "type": "string",
          "enum": ["started", "healthy"]
        }
      },
      "additionalProperties": false
    },
    "dependsOnOrString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/dependsOnEntry" }
      ]
    },
    "component": {
      "type": "object",
      "properties": {
        "runtime": { "$ref": "#/$defs/runtime" },
        "image": { "type": "string" },
        "build": { "$ref": "#/$defs/buildOrString" },
        "source": {
          "type": "string",
          "description": "Working directory for source-mode commands (install/dev). Defaults to build.context, then the repo root (D-38)."
        },
        "provides": {
          "type": "array",
          "items": { "$ref": "#/$defs/provides" }
        },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirementOrString" }
        },
        "supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirementOrString" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/envVarOrScalar" }
        },
        "commands": { "$ref": "#/$defs/commands" },
        "health": { "$ref": "#/$defs/healthOrString" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependsOnOrString" }
        },
        "storage": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/storageVolume" }
        },
        "restart": { "$ref": "#/$defs/restartPolicy" },
        "schedule": { "type": "string" },
        "singleton": { "type": "boolean" },
        "platform": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "host": { "$ref": "#/$defs/host" }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "description": "DEPRECATED (D-54) — legacy top-level host block. Host-level capabilities the app requires beyond a standard container. Use host-capability entries in requires/supports instead (D-44). Still valid in launch/v1; removed in launch/v2.",
      "deprecated": true,
      "x-launchfile-deprecation": {
        "deprecated_in": "launch/v1",
        "removed_in": "launch/v2",
        "replacement": "requires[].host / supports[].host",
        "hint": "Replace the `host:` block with host-capability entries: each key becomes a `- host: { <capability>: <value> }` entry under `requires` (or `supports` when optional). See SPEC.md § Host for the per-key table."
      },
      "properties": {
        "docker": {
          "type": "string",
          "enum": ["required", "optional"],
          "description": "DEPRECATED (D-54) — whether the app needs Docker daemon access on the host. Replaced by the container_runtime capability entry.",
          "deprecated": true,
          "x-launchfile-deprecation": {
            "deprecated_in": "launch/v1",
            "removed_in": "launch/v2",
            "replacement": "requires[].host.container_runtime",
            "hint": "Replace `host: { docker: required }` with `requires: [ - host: { container_runtime: docker } ]`. For `optional`, put the same entry under `supports`."
          }
        },
        "network": {
          "type": "string",
          "enum": ["host", "bridge"],
          "description": "DEPRECATED (D-54) — network mode. Replaced by the network capability entry.",
          "default": "bridge",
          "deprecated": true,
          "x-launchfile-deprecation": {
            "deprecated_in": "launch/v1",
            "removed_in": "launch/v2",
            "replacement": "requires[].host.network",
            "hint": "Replace `host: { network: host }` with `requires: [ - host: { network: host } ]`. `bridge` is the default — drop the key instead of writing an entry."
          }
        },
        "filesystem": {
          "type": "string",
          "enum": ["read-write", "read-only", "none"],
          "description": "DEPRECATED (D-54) — host filesystem access level. Replaced by the filesystem capability entry.",
          "default": "none",
          "deprecated": true,
          "x-launchfile-deprecation": {
            "deprecated_in": "launch/v1",
            "removed_in": "launch/v2",
            "replacement": "requires[].host.filesystem",
            "hint": "Replace `host: { filesystem: read-write }` with `requires: [ - host: { filesystem: read-write } ]`. `none` is the default — drop the key instead of writing an entry."
          }
        },
        "privileged": {
          "type": "boolean",
          "description": "DEPRECATED (D-54) — requires elevated privileges (e.g., device access). Replaced by the privileged capability entry.",
          "default": false,
          "deprecated": true,
          "x-launchfile-deprecation": {
            "deprecated_in": "launch/v1",
            "removed_in": "launch/v2",
            "replacement": "requires[].host.privileged",
            "hint": "Replace `host: { privileged: true }` with `requires: [ - host: { privileged: true } ]`. `false` is the default — drop the key instead of writing an entry."
          }
        }
      },
      "additionalProperties": false
    }
  }
}
